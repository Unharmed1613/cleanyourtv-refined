<?xml version="1.0" encoding="utf-8"?>
<!-- Control Centre volume bar: the filled part, white on the panel and near black on the focused white row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FF111111" /><corners android:radius="3dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="3dp" /></shape>
    </item>
</selector>
